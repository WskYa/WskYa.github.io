---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((post) => !post.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// 阅读时长估算：中文约 400 字/分钟，英文约 200 词/分钟
const body = post.body ?? '';
const zhChars = (body.match(/[\u4e00-\u9fa5]/g) || []).length;
const latinWords = body
  .replace(/[\u4e00-\u9fa5]/g, ' ')
  .split(/\s+/)
  .filter(Boolean).length;
const minutes = Math.max(1, Math.round(zhChars / 400 + latinWords / 200));

const fmt = (d: Date) =>
  d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
>
  <article class="container-narrow">
    <header class="post-header">
      <a class="back-link" href="/blog/">← 所有文章</a>
      <h1 class="post-title">{post.data.title}</h1>
      <div class="post-meta">
        {post.data.pubDate && (
          <time datetime={post.data.pubDate.toISOString()}>
            {fmt(post.data.pubDate)}
          </time>
        )}
        <span>阅读约 {minutes} 分钟</span>
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
