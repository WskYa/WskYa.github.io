---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort(
    (a, b) =>
      (b.data.pubDate?.valueOf() ?? Number.MAX_SAFE_INTEGER) -
      (a.data.pubDate?.valueOf() ?? Number.MAX_SAFE_INTEGER)
  );

const fmt = (d: Date | undefined) =>
  d ? d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }) : '';
---

<BaseLayout title="文章" description="ALL0VEPH4U 的全部文章，按时间排序。">
  <div class="container-narrow">
    <header class="post-header">
      <h1 class="post-title">文章</h1>
      <p class="page-subtitle" id="post-count">共 {posts.length} 篇 · 持续更新中</p>
    </header>
    <div class="search">
      <svg class="search__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <circle cx="7" cy="7" r="4.5" />
        <path d="m10.5 10.5 3.5 3.5" />
      </svg>
      <input
        class="search__input"
        id="post-search"
        type="search"
        placeholder="搜索文章标题或内容…"
        autocomplete="off"
        aria-label="搜索文章"
      />
    </div>
    <ul class="post-list" id="post-list">
      {
        posts.map((post) => (
          <li data-id={post.id}>
            <a class="post-row" href={`/blog/${post.id}/`}>
              {post.data.pubDate && (
                <time class="post-row__time" datetime={post.data.pubDate.toISOString()}>
                  {fmt(post.data.pubDate)}
                </time>
              )}
              <div>
                <span class="post-row__title">{post.data.title || post.id}</span>
                <p class="post-row__desc">{post.data.description}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<script>
  // 站内全文搜索：构建时生成 search-index.json，前端即时过滤
  const input = document.getElementById('post-search');
  const list = document.getElementById('post-list');
  const count = document.getElementById('post-count');
  const items = Array.from(list?.querySelectorAll('li') ?? []);
  let indexPromise = null;

  if (input && list && count && items.length > 0) {
    const getIndex = () =>
      (indexPromise ??= fetch('/search-index.json').then((r) => r.json()));

    const matches = (entry, terms) => {
      const hay = `${entry.title} ${entry.description} ${entry.content}`.toLowerCase();
      return terms.every((t) => hay.includes(t));
    };

    const render = (visible) => {
      items.forEach((li) => (li.style.display = visible.has(li.dataset.id) ? '' : 'none'));
      count.textContent = input.value.trim()
        ? `找到 ${visible.size} 篇相关文章`
        : `共 ${items.length} 篇 · 持续更新中`;
    };

    input.addEventListener('input', async () => {
      const query = input.value.trim();
      const all = new Set(items.map((li) => li.dataset.id));
      if (!query) return render(all);
      const terms = query.toLowerCase().split(/\s+/);
      const index = await getIndex();
      render(new Set(index.filter((e) => matches(e, terms)).map((e) => e.id)));
    });
  }
</script>
