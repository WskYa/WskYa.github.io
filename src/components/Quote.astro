---
import { quotes } from '../data/quotes';

// 服务端先渲染一句（供无 JS / 搜索引擎场景），前端加载后随机再换一句
const initial = quotes[Math.floor(Math.random() * quotes.length)];
---

<section class="quote-band">
  <div class="container">
    <blockquote class="quote">
      <div class="quote__mark" aria-hidden="true">“</div>
      <p class="quote__text" id="quote-text">{initial.text}</p>
      <div class="quote__foot">
        <span class="quote__author" id="quote-author">— {initial.author}</span>
        <button
          class="quote__refresh"
          id="quote-refresh"
          type="button"
          aria-label="换一句名言"
          title="换一句"
        >
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M13.5 8a5.5 5.5 0 1 1-1.6-3.9" />
            <path d="M13.5 1.8v2.9h-2.9" />
          </svg>
        </button>
      </div>
    </blockquote>
  </div>
</section>

<script define:vars={{ quotes }}>
  const textEl = document.getElementById('quote-text');
  const authorEl = document.getElementById('quote-author');
  const refreshBtn = document.getElementById('quote-refresh');
  if (textEl && authorEl && refreshBtn && quotes.length > 0) {
    let timer = null;
    const pick = () => {
      const q = quotes[Math.floor(Math.random() * quotes.length)];
      textEl.classList.add('quote--fade');
      clearTimeout(timer);
      timer = setTimeout(() => {
        textEl.textContent = q.text;
        authorEl.textContent = `— ${q.author}`;
        textEl.classList.remove('quote--fade');
      }, 200);
    };
    refreshBtn.addEventListener('click', pick);
    pick(); // 每次访问随机换一句
  }
</script>
