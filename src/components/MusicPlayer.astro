---
import { songs } from '../data/music';

const first = songs[0];
---

<div class="music">
  <button
    class="music__btn"
    id="music-btn"
    type="button"
    aria-label="打开音乐播放器"
    aria-expanded="false"
  >
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 12.5V4.2l7-1.7v8.5" />
      <circle cx="4" cy="12.5" r="1.8" />
      <circle cx="11" cy="11" r="1.8" />
    </svg>
  </button>

  <div class="music__panel" id="music-panel" hidden>
    <div class="music__head">
      <span class="music__title">音乐</span>
      <button class="music__close" id="music-close" type="button" aria-label="关闭播放器">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <path d="M3.5 3.5l9 9M12.5 3.5l-9 9" />
        </svg>
      </button>
    </div>
    <div class="music__frame-wrap">
      <iframe
        id="music-frame"
        title="网易云音乐播放器"
        width="100%"
        height="66"
        frameborder="no"
        border="0"
        marginwidth="0"
        marginheight="0"
        allow="autoplay"
      ></iframe>
    </div>
    <div class="music__nav">
      <button class="music__step" id="music-prev" type="button" aria-label="上一首">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M11 3.5 6 8l5 4.5" />
        </svg>
      </button>
      <span class="music__track" id="music-track">{first ? `${first.title} · ${first.artist}` : '暂无歌曲'}</span>
      <button class="music__step" id="music-next" type="button" aria-label="下一首">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 3.5 10 8l-5 4.5" />
        </svg>
      </button>
    </div>
  </div>
</div>

<script define:vars={{ songs }}>
  const btn = document.getElementById('music-btn');
  const panel = document.getElementById('music-panel');
  const closeBtn = document.getElementById('music-close');
  const frame = document.getElementById('music-frame');
  const trackEl = document.getElementById('music-track');
  const prevBtn = document.getElementById('music-prev');
  const nextBtn = document.getElementById('music-next');

  if (btn && panel && frame && songs.length > 0) {
    let index = 0;
    let loaded = false;

    const load = (i) => {
      const s = songs[i];
      // 网易云官方外链播放器：type=2 单曲，id 为歌曲 ID
      frame.src = `https://music.163.com/outchain/player?type=2&id=${s.id}&auto=0&height=66`;
      if (trackEl) trackEl.textContent = `${s.title} · ${s.artist}`;
    };

    const open = () => {
      if (!loaded) {
        load(index);
        loaded = true;
      }
      panel.hidden = false;
      btn.setAttribute('aria-expanded', 'true');
    };

    const close = () => {
      panel.hidden = true;
      btn.setAttribute('aria-expanded', 'false');
    };

    btn.addEventListener('click', () => (panel.hidden ? open() : close()));
    closeBtn?.addEventListener('click', close);
    prevBtn?.addEventListener('click', () => {
      index = (index - 1 + songs.length) % songs.length;
      if (loaded) load(index);
    });
    nextBtn?.addEventListener('click', () => {
      index = (index + 1) % songs.length;
      if (loaded) load(index);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) close();
    });
    document.addEventListener('click', (e) => {
      if (!panel.hidden && !panel.contains(e.target) && !btn.contains(e.target)) close();
    });
  }
</script>
